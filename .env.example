# ==========================================================
# StayEase Hotel Booking System - Environment Variables
# Copy to .env and configure for your local or cloud environment
# ==========================================================

# Flask Environment
FLASK_ENV=development
PORT=5000
DEBUG=true

# Security Secrets (Generate secure random keys for production)
SECRET_KEY=stayease-secret-super-key-2026-cloud
JWT_SECRET_KEY=stayease-jwt-cloud-hotel-jwt-secret-xyz-777

# Database Connection (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_USER=hotel_user
DB_PASSWORD=hotel_password_secure_2026
DB_NAME=hotel_booking_db

# Fallback Mode (Automatic SQLite database if MySQL container is not running)
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=database/hotel_booking.sqlite

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80,http://localhost:5000

# AWS Deployment Configuration (Used by Terraform & Ansible)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Monitoring & Prometheus
PROMETHEUS_METRICS_PATH=/metrics
